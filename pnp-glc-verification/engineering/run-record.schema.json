{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evemisslab:pnp-glc:run-record:0.1.0",
  "title": "P/NP GLC Observatory Run Record",
  "description": "Minimal event-sourced record for cognitive-dynamics and SAT benchmark runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recorded_at",
    "track",
    "ctcl",
    "experiment",
    "provenance",
    "claims",
    "problem",
    "mechanism",
    "admission_validation",
    "ledger",
    "events",
    "result",
    "failure_frontier"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "track": {
      "enum": ["cognitive", "algorithm"]
    },
    "ctcl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instant", "role"],
      "properties": {
        "instant": {
          "type": "string",
          "pattern": "^ctcl:instant:[0-9a-fA-F-]{36}$"
        },
        "role": {
          "const": "coordination-only"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "status", "hypothesis_id", "seed", "series_semantics"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["planned", "running", "completed", "failed", "rejected"]
        },
        "hypothesis_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "series_semantics": {
          "enum": ["single-instance", "fixed-program-scaling", "pointwise-envelope"]
        },
        "pre_registered_metrics": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "implementation"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "implementation": {"$ref": "#/$defs/implementation"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/claim"}
    },
    "problem": {"$ref": "#/$defs/problem"},
    "mechanism": {"$ref": "#/$defs/mechanism"},
    "admission_validation": {"$ref": "#/$defs/admissionValidation"},
    "ledger": {"$ref": "#/$defs/ledger"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    },
    "result": {"$ref": "#/$defs/result"},
    "failure_frontier": {"$ref": "#/$defs/failureFrontier"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^(sha256:)?[A-Fa-f0-9]{64}$"
    },
    "nullableHash": {
      "anyOf": [
        {"$ref": "#/$defs/hash"},
        {"type": "null"}
      ]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locator",
        "version",
        "sha256",
        "applicable_domain",
        "accessed_at",
        "visibility"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "bundle", "web", "generated", "implementation"]},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "applicable_domain": {"type": "string", "minLength": 1},
        "accessed_at": {"type": "string", "format": "date-time"},
        "visibility": {"enum": ["private", "shared", "public"]}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision",
        "dirty",
        "runtime",
        "dependencies"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "runtime": {"type": "string", "minLength": 1},
        "binary_sha256": {"$ref": "#/$defs/hash"},
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/hash"}
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "statement",
        "status",
        "source_refs",
        "domain",
        "quantifiers",
        "assumptions",
        "failure_conditions"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {
          "enum": [
            "Definition",
            "Observation",
            "Lemma",
            "Conditional",
            "Conjecture",
            "Counterexample",
            "Experiment",
            "Open Problem"
          ]
        },
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "superseded", "rejected", "inconclusive"]},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "domain": {"type": "string", "minLength": 1},
        "quantifiers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "assumptions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "failure_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "supersedes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "instance_id",
        "input_sha256",
        "generator",
        "size",
        "contract"
      ],
      "properties": {
        "family": {
          "enum": [
            "claim-ledger-repair",
            "2-SAT",
            "Horn-SAT",
            "XOR-SAT",
            "bounded-treewidth-SAT",
            "general-3-SAT",
            "other"
          ]
        },
        "instance_id": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "seed", "parameters"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "seed": {"type": "integer", "minimum": 0},
            "parameters": {"type": "object"}
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": {
            "type": ["integer", "number", "string", "boolean", "null"]
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sha256", "completion_requirements"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/hash"},
            "completion_requirements": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "role",
        "resource_regime",
        "run_quantifier",
        "baseline_id",
        "operations",
        "admissibility",
        "oracle"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "role": {"enum": ["baseline", "candidate"]},
        "resource_regime": {"enum": ["resource-neutral", "resource-bounded"]},
        "run_quantifier": {"enum": ["standard", "robust"]},
        "baseline_id": {"type": ["string", "null"]},
        "operations": {
          "type": "array",
          "items": {
            "enum": [
              "state-switch",
              "representation-rewrite",
              "build",
              "step",
              "rollback",
              "reroute",
              "self-correct",
              "refine",
              "lift",
              "verify",
              "restart",
              "decode",
              "commit",
              "solve"
            ]
          },
          "uniqueItems": true
        },
        "admissibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uniform",
            "oracle_free",
            "finite_precision",
            "program_quantifiers",
            "builder_ref",
            "step_ref",
            "decode_ref",
            "declared_answer_access",
            "advice_generator_ref",
            "local_invariant_ref",
            "randomness",
            "interaction",
            "advice",
            "parallelism",
            "hardware"
          ],
          "properties": {
            "uniform": {"type": "boolean"},
            "oracle_free": {"type": "boolean"},
            "finite_precision": {"type": "boolean"},
            "program_quantifiers": {"type": "string", "minLength": 1},
            "builder_ref": {"$ref": "#/$defs/hash"},
            "step_ref": {"$ref": "#/$defs/hash"},
            "decode_ref": {"$ref": "#/$defs/hash"},
            "declared_answer_access": {
              "enum": ["none", "truth-table", "answer-oracle", "unknown"]
            },
            "advice_generator_ref": {"$ref": "#/$defs/nullableHash"},
            "local_invariant_ref": {"$ref": "#/$defs/nullableHash"},
            "randomness": {"enum": ["none", "seeded", "unseeded"]},
            "interaction": {"type": "string"},
            "advice": {"type": "string"},
            "parallelism": {"type": "string"},
            "hardware": {"type": "string", "minLength": 1}
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "independent", "checks", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "independent": {"type": "boolean"},
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "sha256": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "admissionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_version",
        "decision_source",
        "validator_sha256",
        "independent",
        "capability_sandbox_ref",
        "run_spec_ref",
        "maximal_run_spec_ref",
        "fairness_spec_ref",
        "trace_sha256",
        "resolved_refs",
        "observed_answer_access",
        "derived",
        "evidence_refs"
      ],
      "properties": {
        "gate_version": {"type": "string", "minLength": 1},
        "decision_source": {"const": "external-validator"},
        "validator_sha256": {"$ref": "#/$defs/hash"},
        "independent": {"type": "boolean"},
        "capability_sandbox_ref": {"$ref": "#/$defs/hash"},
        "run_spec_ref": {"$ref": "#/$defs/hash"},
        "maximal_run_spec_ref": {"$ref": "#/$defs/nullableHash"},
        "fairness_spec_ref": {"$ref": "#/$defs/nullableHash"},
        "trace_sha256": {"$ref": "#/$defs/hash"},
        "resolved_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/hash"},
          "uniqueItems": true
        },
        "observed_answer_access": {
          "enum": ["none", "truth-table", "answer-oracle", "unknown"]
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uniformity_pass",
            "provenance_pass",
            "refs_resolved_pass",
            "builder_execution_pass",
            "advice_generation_pass",
            "proof_verification_pass",
            "advice_budget_pass",
            "answer_access_pass",
            "resource_budget_pass",
            "oracle_free_pass",
            "replay_pass",
            "run_class_nonempty",
            "maximality_pass",
            "fairness_pass",
            "admission_pass",
            "reasons"
          ],
          "properties": {
            "uniformity_pass": {"type": "boolean"},
            "provenance_pass": {"type": "boolean"},
            "refs_resolved_pass": {"type": "boolean"},
            "builder_execution_pass": {"type": "boolean"},
            "advice_generation_pass": {"type": "boolean"},
            "proof_verification_pass": {"type": "boolean"},
            "advice_budget_pass": {"type": "boolean"},
            "answer_access_pass": {"type": "boolean"},
            "resource_budget_pass": {"type": "boolean"},
            "oracle_free_pass": {"type": "boolean"},
            "replay_pass": {"type": "boolean"},
            "run_class_nonempty": {"type": "boolean"},
            "maximality_pass": {"type": "boolean"},
            "fairness_pass": {"type": "boolean"},
            "admission_pass": {"type": "boolean"},
            "reasons": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/hash"},
          "uniqueItems": true
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction",
        "generation",
        "update",
        "decode",
        "lift",
        "verify",
        "recovery",
        "restart",
        "parallel_work",
        "oracle",
        "total"
      ],
      "properties": {
        "construction": {"$ref": "#/$defs/nonNegativeInteger"},
        "generation": {"$ref": "#/$defs/nonNegativeInteger"},
        "update": {"$ref": "#/$defs/nonNegativeInteger"},
        "decode": {"$ref": "#/$defs/nonNegativeInteger"},
        "lift": {"$ref": "#/$defs/nonNegativeInteger"},
        "verify": {"$ref": "#/$defs/nonNegativeInteger"},
        "recovery": {"$ref": "#/$defs/nonNegativeInteger"},
        "restart": {"$ref": "#/$defs/nonNegativeInteger"},
        "parallel_work": {"$ref": "#/$defs/nonNegativeInteger"},
        "oracle": {"$ref": "#/$defs/nonNegativeInteger"},
        "total": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "debtItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "introduced_event",
        "contract_requirement",
        "status",
        "retirement_condition",
        "retirement_evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "introduced_event": {"type": "integer", "minimum": 0},
        "contract_requirement": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "retired", "waived"]},
        "retirement_condition": {"type": "string", "minLength": 1},
        "retirement_evidence": {"type": ["string", "null"]}
      }
    },
    "phaseAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_ns", "peak_space_bytes", "peak_output_bytes"],
      "properties": {
        "time_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "peak_space_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "peak_output_bytes": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ns",
        "space_bytes",
        "description_bytes",
        "admission_costs",
        "precision",
        "counts",
        "semantic_loss_debt",
        "resource_account_complete"
      ],
      "properties": {
        "time_ns": {"$ref": "#/$defs/costs"},
        "space_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peak", "final", "artifacts"],
          "properties": {
            "peak": {"$ref": "#/$defs/nonNegativeInteger"},
            "final": {"$ref": "#/$defs/nonNegativeInteger"},
            "artifacts": {"$ref": "#/$defs/nonNegativeInteger"}
          }
        },
        "description_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program_code", "advice", "builder_artifacts", "generated_tables", "proof"],
          "properties": {
            "program_code": {"$ref": "#/$defs/nonNegativeInteger"},
            "advice": {"$ref": "#/$defs/nonNegativeInteger"},
            "builder_artifacts": {"$ref": "#/$defs/nonNegativeInteger"},
            "generated_tables": {"$ref": "#/$defs/nonNegativeInteger"},
            "proof": {"$ref": "#/$defs/nonNegativeInteger"}
          }
        },
        "admission_costs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["builder", "advice_generation", "proof_verification"],
          "properties": {
            "builder": {"$ref": "#/$defs/phaseAccount"},
            "advice_generation": {"$ref": "#/$defs/phaseAccount"},
            "proof_verification": {"$ref": "#/$defs/phaseAccount"}
          }
        },
        "precision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "peak_bits"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "peak_bits": {"$ref": "#/$defs/nonNegativeInteger"}
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "states",
            "branches",
            "switches",
            "rollbacks",
            "reroutes",
            "refinements",
            "restarts",
            "parallel_workers_peak"
          ],
          "properties": {
            "states": {"$ref": "#/$defs/nonNegativeInteger"},
            "branches": {"$ref": "#/$defs/nonNegativeInteger"},
            "switches": {"$ref": "#/$defs/nonNegativeInteger"},
            "rollbacks": {"$ref": "#/$defs/nonNegativeInteger"},
            "reroutes": {"$ref": "#/$defs/nonNegativeInteger"},
            "refinements": {"$ref": "#/$defs/nonNegativeInteger"},
            "restarts": {"$ref": "#/$defs/nonNegativeInteger"},
            "parallel_workers_peak": {"$ref": "#/$defs/nonNegativeInteger"}
          }
        },
        "semantic_loss_debt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registered", "peak_open", "outstanding"],
          "properties": {
            "registered": {
              "type": "array",
              "items": {"$ref": "#/$defs/debtItem"}
            },
            "peak_open": {"$ref": "#/$defs/nonNegativeInteger"},
            "outstanding": {"$ref": "#/$defs/nonNegativeInteger"}
          }
        },
        "resource_account_complete": {"type": "boolean"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "kind",
        "from_state",
        "to_state",
        "representation_before",
        "representation_after",
        "input_sha256",
        "output_sha256",
        "transition_rule_ref",
        "invariant_ref",
        "time_ns",
        "debt_added",
        "debt_retired",
        "status"
      ],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "kind": {
          "enum": [
            "observe",
            "classify",
            "state-switch",
            "build",
            "step",
            "rewrite",
            "solve",
            "verify",
            "self-correct",
            "refine",
            "checkpoint",
            "rollback",
            "reroute",
            "restart",
            "lift",
            "decode",
            "commit",
            "stop"
          ]
        },
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1},
        "representation_before": {"type": "string", "minLength": 1},
        "representation_after": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "output_sha256": {"$ref": "#/$defs/hash"},
        "transition_rule_ref": {"type": ["string", "null"]},
        "invariant_ref": {"type": ["string", "null"]},
        "time_ns": {"$ref": "#/$defs/costs"},
        "debt_added": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "debt_retired": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "status": {"enum": ["ok", "failed", "rolled-back", "skipped"]},
        "failure": {"type": ["string", "null"]}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "answer",
        "certificate_refs",
        "oracle_pass",
        "contract_pass",
        "complete",
        "budget_pass",
        "outstanding_loss_debt",
        "final_completion"
      ],
      "properties": {
        "status": {
          "enum": ["sat", "unsat", "complete", "incomplete", "unknown", "timeout", "error"]
        },
        "answer": {},
        "certificate_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "oracle_pass": {"type": "boolean"},
        "contract_pass": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "budget_pass": {"type": "boolean"},
        "outstanding_loss_debt": {"$ref": "#/$defs/nonNegativeInteger"},
        "final_completion": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "failureFrontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "first_observed_failure", "censored", "interpretation"],
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "value": {"type": ["integer", "number", "string", "boolean", "null"]},
              "unit": {"type": "string"}
            }
          }
        },
        "first_observed_failure": {"type": ["string", "null"]},
        "censored": {"type": "boolean"},
        "interpretation": {"type": "string", "minLength": 1}
      }
    }
  }
}
