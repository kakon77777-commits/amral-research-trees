  "nodes": [
    {
      "id": "project",
      "kind": "project",
      "label": "Is the First-Crossing Reset Inequality a second fact, or the Correction Bound restated?",
      "path": "project_snapshot.yaml",
      "sha256": "3f0168cc2245df7ee2a746e22ca4bd64e51c73d8eaba98fe1c86ce0721895a79"
    },
    {
      "id": "claim:reset_follows_from_the_correction_bound",
      "kind": "claim",
      "label": "At L=5, the correction bound b <= 405 implies the reset inequality, for every start y in the declared range.\n",
      "path": "claims/reset_follows_from_the_correction_bound/metrics.json",
      "sha256": null
    },
    {
      "id": "claim:reset_needs_the_correction_bound",
      "kind": "claim",
      "label": "The reset inequality does NOT hold on its own. FALSE on this domain, and a solver should hand back a counterexample rather than a proof.\n",
      "path": "claims/reset_needs_the_correction_bound/metrics.json",
      "sha256": null
    },
    {
      "id": "claim:reset_is_equivalent_to_the_correction_bound",
      "kind": "claim",
      "label": "The two are the same statement: each implies the other, so the reset inequality carries no information about y at all.\n",
      "path": "claims/reset_is_equivalent_to_the_correction_bound/metrics.json",
      "sha256": null
    },
    {
      "id": "claim:the_general_form_has_a_symbolic_exponent",
      "kind": "claim",
      "label": "With L symbolic the same claim needs 3^L and 2^Q, which SMT-LIB2 cannot render exactly. Declared so that the refusal is on the record.\n",
      "path": "claims/the_general_form_has_a_symbolic_exponent/metrics.json",
      "sha256": null
    },
    {
      "id": "analysis:prove_reset_from_bound",
